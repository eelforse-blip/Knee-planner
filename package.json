    "android:sync": "cap sync android",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2"
  }
}
